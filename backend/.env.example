# Groq AI Model Credentials
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# JWT Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_32_character_string

# Database Connection (Defaults to SQLite; use PostgreSQL for production cloud databases)
DATABASE_URL=sqlite:///./careerpilot.db
# DATABASE_URL=postgresql://user:password@host:5432/careerpilot_prod

# Allowed CORS Origins (comma-separated list of deployed frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173,https://your-careerpilot-app.vercel.app

